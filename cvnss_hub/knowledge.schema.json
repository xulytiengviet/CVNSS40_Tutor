{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CVNSS4.0 knowledge registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "notice",
    "topics",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "cvnss4-knowledge/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "title",
          "statement",
          "evidence_type",
          "review_status",
          "source_refs",
          "source_locator",
          "exact_quote",
          "reviewer",
          "reviewed_at",
          "examples",
          "test_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "enum": [
              "history",
              "concepts",
              "nature",
              "characteristics",
              "functions",
              "rules",
              "formulas",
              "value",
              "applications",
              "limitations"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_type": {
            "enum": [
              "primary_source",
              "implementation",
              "experiment",
              "proposal",
              "unverified"
            ]
          },
          "review_status": {
            "enum": [
              "draft",
              "needs_review",
              "approved",
              "disputed",
              "superseded"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "exact_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "review_status": {
                  "const": "approved"
                }
              }
            },
            "then": {
              "properties": {
                "source_refs": {
                  "minItems": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_type": {
                  "const": "primary_source"
                },
                "review_status": {
                  "const": "approved"
                }
              }
            },
            "then": {
              "properties": {
                "exact_quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
